{
  "poses": {
    "two": {
      "name": "Chrome",
      "run": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
    },
    "three": {
      "name": "Claude",
      "run": "shell:AppsFolder\\Claude_pzs8sxrjxfjjc!Claude"
    },
    "four": {
      "name": "Antigravity",
      "run": "%LOCALAPPDATA%\\Programs\\Antigravity\\Antigravity.exe"
    },
    "thumbs_up": {
      "name": "File Explorer",
      "run": "explorer.exe"
    },
    "thumbs_down": {
      "name": "Undo",
      "keys": "ctrl+z"
    },
    "call_me": {
      "name": "Spotify",
      "run": "%APPDATA%\\Spotify\\Spotify.exe"
    },
    "l_shape": {
      "name": "Screenshot",
      "keys": "win+shift+s"
    }
  },
  "motions": {
    "swipe_left": {
      "name": "Next tab",
      "keys": "ctrl+tab"
    },
    "swipe_right": {
      "name": "Previous tab",
      "keys": "ctrl+shift+tab"
    },
    "swipe_up": {
      "name": "Task view",
      "keys": "win+tab"
    },
    "two_swipe_left": {
      "name": "Switch app",
      "keys": "alt+tab"
    },
    "two_swipe_right": {
      "name": "Switch app back",
      "keys": "alt+shift+tab"
    },
    "push": {
      "name": "Play / pause",
      "keys": "media_play_pause"
    },
    "zoom_in": {
      "name": "Zoom in",
      "keys": "ctrl+="
    },
    "zoom_out": {
      "name": "Zoom out",
      "keys": "ctrl+-"
    },
    "two_swipe_down": {
      "name": "Clipboard shelf",
      "action": "shelf"
    },
    "two_swipe_up": {
      "name": "Link",
      "action": "link"
    }
  },
  "per_app": {
    "Code.exe": {
      "swipe_left": {
        "name": "Next tab",
        "keys": "ctrl+page_down"
      },
      "swipe_right": {
        "name": "Previous tab",
        "keys": "ctrl+page_up"
      }
    },
    "Antigravity.exe": {
      "swipe_left": {
        "name": "Next tab",
        "keys": "ctrl+page_down"
      },
      "swipe_right": {
        "name": "Previous tab",
        "keys": "ctrl+page_up"
      }
    }
  }
}